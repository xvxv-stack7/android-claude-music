# "一起听"的配置 —— 复制成同目录下的 music.env 再填
#
#   cp music.env.example music.env
#
# music.env 是你的私人配置，别提交进任何仓库（.gitignore 已经挡了）。

# ── 必填 ─────────────────────────────────────────────
# 你的"我喜欢"歌单 id
# 登录后看这个接口的返回：curl "http://127.0.0.1:4000/user/playlist?userid=<你的userid>"
# 形如 collection_3_<你的userid>_2_0
MUSIC_LIKE_ID=

# ── 一般不用改 ───────────────────────────────────────
# 音乐 App 的包名（默认酷狗）
# 拿包名：adb shell pm list packages | grep -i <关键词>
# ⚠️ 换 App **只改这一行不够** —— 歌单和歌词还依赖"对应的本地接口服务"
#    （默认那套是酷狗的）。详见 README「在你手机上要改的」。
MUSIC_PKG=com.kugou.android

# 本地音乐接口服务
# MUSIC_API=http://127.0.0.1:4000

# adb 设备（走回环，见 android-claude-agent）
# ADB_SERIAL=127.0.0.1:5555

# "该放歌了"的冷却时间（分钟），防连环放
# MUSIC_COOLDOWN_MIN=40
